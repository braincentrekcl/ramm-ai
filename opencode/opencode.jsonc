{
  "$schema": "https://opencode.ai/config.json",
  // Change /path/to/ramm-ai to where you put the RAMM-AI folder, here and in
  // the two rules below that let RAMM-AI read its own skill files.
  "skills": ["/path/to/ramm-ai/skills"],
  // RAMM-AI never runs commands, never reads your data, and only writes in code/
  // and envs/.
  // The last matching rule wins, so each exception follows its broad rule.
  "permissions": [
    // OpenCode's free models stop working while shell is denied
    // (https://github.com/anomalyco/opencode/issues/51241; remove this note
    // when it is fixed). To use one, change "deny" to "ask" here and decline
    // any command that reads your data.
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "grep", "resource": "*", "effect": "deny" },
    // Nothing outside the study folder.
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    // Except RAMM-AI's own skill files, which it reads before writing a script;
    // they hold no user data, and edit stays denied below.
    { "action": "external_directory", "resource": "/path/to/ramm-ai/skills/*", "effect": "allow" },
    // In the study folder, read nothing except what is allowed below.
    // OpenCode matches these against the path relative to the study folder
    // inside it, and against the full path outside it (after external_directory).
    { "action": "read", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "/path/to/ramm-ai/skills/*", "effect": "allow" },
    // The scripts and environment files RAMM-AI writes, by name, so a data
    // file kept beside them stays unreadable.
    { "action": "read", "resource": "code/*.R", "effect": "allow" },
    { "action": "read", "resource": "envs/Dockerfile", "effect": "allow" },
    { "action": "read", "resource": "envs/Dockerfile.dockerignore", "effect": "allow" },
    { "action": "read", "resource": "envs/apptainer.def", "effect": "allow" },
    { "action": "read", "resource": "envs/README.md", "effect": "allow" },
    { "action": "read", "resource": "envs/renv.lock", "effect": "allow" },
    // The files the script writes in outputs/, so RAMM-AI can explain them,
    // and nothing in folders inside outputs/.
    { "action": "read", "resource": "outputs/results_*", "effect": "allow" },
    { "action": "read", "resource": "outputs/plot_*", "effect": "allow" },
    { "action": "read", "resource": "outputs/*_log.txt", "effect": "allow" },
    { "action": "read", "resource": "outputs/provenance.csv", "effect": "allow" },
    { "action": "read", "resource": "outputs/*/*", "effect": "deny" },
    // In inputs/, only input.md and files whose names start with toy_.
    { "action": "read", "resource": "inputs/input.md", "effect": "allow" },
    { "action": "read", "resource": "inputs/toy_*", "effect": "allow" },
    { "action": "read", "resource": "inputs/toy_*/*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "code/*", "effect": "allow" },
    { "action": "edit", "resource": "envs/*", "effect": "allow" },
    // No Code Mode, helper agents or web access: Code Mode can read files
    // that the read rules above deny.
    { "action": "execute", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" }
  ]
}
